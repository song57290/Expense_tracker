<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/config_bg"
    android:fitsSystemWindows="true">

    <!-- 글자 크기 옵션이 추가되면서 화면이 작은 기기에서는 전체 내용이 화면보다
         길어져 저장/취소 버튼이 화면 밖으로 밀려 아예 안 보이고 누를 수도 없던
         문제가 있었다 — 스크롤 가능하게 감싸고, 저장/취소는 화면 하단에 고정된
         채로 항상 보이게 바깥에 둔다. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- 제목 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="위젯 설정"
        android:textColor="@color/config_text"
        android:textSize="26sp"
        android:textStyle="bold"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="4dp" />

    <!-- 미리보기 -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp" />

    <!-- 배경 색상 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="배경 색상"
        android:textColor="@color/config_hint"
        android:textSize="13sp"
        android:paddingStart="36dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_config_section"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="1dp">

        <!-- 투명 -->
        <LinearLayout
            android:id="@+id/opt_transparent"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <View
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_swatch_transparent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="투명"
                    android:textColor="@color/config_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="배경화면이 비칩니다"
                    android:textColor="@color/config_hint"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/check_transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#7C4DFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/config_divider"
            android:layout_marginStart="52dp" />

        <!-- 시스템 -->
        <LinearLayout
            android:id="@+id/opt_system"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <View
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_swatch_system" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시스템"
                    android:textColor="@color/config_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="단말의 라이트 / 다크 모드에 맞춤"
                    android:textColor="@color/config_hint"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/check_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#7C4DFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/config_divider"
            android:layout_marginStart="52dp" />

        <!-- 흰색 -->
        <LinearLayout
            android:id="@+id/opt_white"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <View
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_swatch_white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="흰색"
                    android:textColor="@color/config_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="밝은 배경"
                    android:textColor="@color/config_hint"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/check_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#7C4DFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/config_divider"
            android:layout_marginStart="52dp" />

        <!-- 검정 -->
        <LinearLayout
            android:id="@+id/opt_black"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <View
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_swatch_black" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="검정"
                    android:textColor="@color/config_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="어두운 배경"
                    android:textColor="@color/config_hint"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/check_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#7C4DFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- 글자 크기 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="글자 크기"
        android:textColor="@color/config_hint"
        android:textSize="13sp"
        android:paddingStart="36dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_config_section"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="1dp">

        <!-- 작게 -->
        <LinearLayout
            android:id="@+id/opt_text_small"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="가"
                android:textColor="@color/config_hint"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="14dp"
                android:text="작게"
                android:textColor="@color/config_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/check_text_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#7C4DFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/config_divider"
            android:layout_marginStart="52dp" />

        <!-- 보통 -->
        <LinearLayout
            android:id="@+id/opt_text_medium"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="가"
                android:textColor="@color/config_hint"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="14dp"
                android:text="보통"
                android:textColor="@color/config_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/check_text_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#7C4DFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/config_divider"
            android:layout_marginStart="52dp" />

        <!-- 크게 -->
        <LinearLayout
            android:id="@+id/opt_text_large"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="가"
                android:textColor="@color/config_hint"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="14dp"
                android:text="크게"
                android:textColor="@color/config_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/check_text_large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#7C4DFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- 그래프 크기 (링 그래프가 있는 위젯에서만 보임 — WidgetConfigActivity에서 visibility 제어) -->
    <LinearLayout
        android:id="@+id/ring_size_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="그래프 크기"
        android:textColor="@color/config_hint"
        android:textSize="13sp"
        android:paddingStart="36dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_config_section"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="1dp">

        <!-- 작게 -->
        <LinearLayout
            android:id="@+id/opt_ring_small"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="◯"
                android:textColor="@color/config_hint"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="14dp"
                android:text="작게"
                android:textColor="@color/config_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/check_ring_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#7C4DFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/config_divider"
            android:layout_marginStart="52dp" />

        <!-- 보통 -->
        <LinearLayout
            android:id="@+id/opt_ring_medium"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="◯"
                android:textColor="@color/config_hint"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="14dp"
                android:text="보통"
                android:textColor="@color/config_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/check_ring_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#7C4DFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/config_divider"
            android:layout_marginStart="52dp" />

        <!-- 크게 -->
        <LinearLayout
            android:id="@+id/opt_ring_large"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="◯"
                android:textColor="@color/config_hint"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="14dp"
                android:text="크게"
                android:textColor="@color/config_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/check_ring_large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="#7C4DFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- 저장 / 취소 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="저장"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_config_btn_save" />

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="취소"
            android:textColor="@color/config_cancel"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/bg_config_btn_cancel" />

    </LinearLayout>

</LinearLayout>