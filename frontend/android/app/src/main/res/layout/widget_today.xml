<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#CC2d1b69">

    <!-- 헤더: 오늘 지출 + 날짜 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="오늘 지출"
            android:textColor="#FFb088f9"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--월 --일"
            android:textColor="#88FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- 오늘 총 지출 -->
    <TextView
        android:id="@+id/today_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="---원"
        android:textColor="#FFff6b6b"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

    <!-- 지출 없을 때 메시지 -->
    <TextView
        android:id="@+id/today_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="오늘 지출 없음"
        android:textColor="#55FFFFFF"
        android:textSize="10sp"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <!-- TOP 3 카테고리 -->
    <LinearLayout
        android:id="@+id/today_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/today_cat1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/today_cat1_amt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFff6b6b"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:id="@+id/today_cat2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/today_cat2_amt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFff6b6b"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:id="@+id/today_cat3_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/today_cat3_amt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFff6b6b"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
