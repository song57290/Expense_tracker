<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pace_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/pace_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="지출 추이"
        android:textColor="@color/w_dim"
        android:textSize="12dp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/pace_daily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="---원"
            android:textColor="@color/w_text"
            android:textSize="26dp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/pace_daily_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="일 평균"
            android:textColor="@color/w_hint"
            android:textSize="11dp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/pace_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/w_divider"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/pace_proj_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이번달 예상 지출"
            android:textColor="@color/w_hint"
            android:textSize="11dp" />

        <TextView
            android:id="@+id/pace_proj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="---원"
            android:textColor="@color/pace_projected"
            android:textSize="18dp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/pace_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/w_hint"
        android:textSize="9dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="end"
        android:layout_marginTop="6dp" />

</LinearLayout>
