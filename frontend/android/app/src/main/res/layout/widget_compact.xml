<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@android:color/transparent">

    <!-- 상단: 월 / 업데이트 시간 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/compact_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026년 7월"
            android:textColor="@color/w_primary"
            android:textSize="15dp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/compact_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23:38"
            android:textColor="@color/w_dim"
            android:textSize="8dp" />

    </LinearLayout>

    <!-- 메인 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <!-- 잔액 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="5dp">

            <TextView
                android:id="@+id/compact_balance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이번 달 요약"
                android:textColor="@color/w_text"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/compact_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-771,763원"
                android:textColor="@color/w_primary"
                android:textSize="18dp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- 수입 카드 -->
        <LinearLayout
            android:id="@+id/compact_income_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/widget_income_bg">

            <TextView
                android:id="@+id/compact_income_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑  수입"
                android:textColor="@color/w_income"
                android:textSize="13dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compact_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="316,817원"
                android:textColor="#F1F1F1F1"
                android:textSize="13dp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- 지출 카드 -->
        <LinearLayout
            android:id="@+id/compact_expense_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/widget_expense_bg">

            <TextView
                android:id="@+id/compact_expense_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓  지출"
                android:textColor="@color/w_expense"
                android:textSize="13dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compact_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1,088,580원"
                android:textColor="#F1F1F1F1"
                android:textSize="13dp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_marginTop="1dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>