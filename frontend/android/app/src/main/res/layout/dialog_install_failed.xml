<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_card"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="26dp"
    android:paddingBottom="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_dialog_icon_badge"
        android:gravity="center"
        android:text="⚠️"
        android:textSize="26sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="설치가 완료되지 않았어요"
        android:textColor="#1C1B20"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="방금 취소하셨다면 무시하셔도 돼요.\n혹시 자동 차단 때문이라면 설정에서\n확인해주세요."
        android:textColor="#6B6B75"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialog_btn_dismiss"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_config_btn_cancel"
            android:text="확인"
            android:textAllCaps="false"
            android:textColor="#4A4A52"
            android:textSize="14sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/dialog_btn_settings"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_config_btn_save"
            android:text="설정으로 이동"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>
